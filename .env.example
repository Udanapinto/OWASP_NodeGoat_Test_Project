# Example configuration only.
# DO NOT put real credentials in this file.

NODE_ENV=development

MONGO_HOST=mongodb
MONGO_PORT=27017

# Example placeholders
MONGO_USERNAME=example_username
MONGO_PASSWORD=example_password

APP_SECRET=example_secret

# MongoDB
MONGODB_URI=mongodb://mongo:27017/nodegoat
MONGODB_USERNAME=example_username
MONGODB_PASSWORD=example_password

# Session
SESSION_SECRET=generate_a_strong_random_secret
APP_SECRET=generate_a_strong_random_secret

# Test user (for local development only)
TEST_USER_PASSWORD=example_password

# Vault (optional — Phase 19)
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=dev-only-root-token
